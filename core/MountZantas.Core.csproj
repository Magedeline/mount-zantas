<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MountZantas.Core</AssemblyName>
    <RootNamespace>MountZantas</RootNamespace>
    <Description>Portable core of Mount Zantas: no UI, runs on Windows, Linux and macOS.</Description>
